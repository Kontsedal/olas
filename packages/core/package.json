{
  "name": "@kontsedal/olas-core",
  "version": "0.8.0",
  "description": "Olas core — controller-tree state management with signals, queries, mutations, and forms. Framework-agnostic.",
  "keywords": [
    "olas",
    "controller-tree",
    "signals",
    "reactive",
    "state-management",
    "query-cache",
    "mutation",
    "optimistic-updates",
    "forms",
    "ssr",
    "framework-agnostic"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "author": "Bohdan Kontsedal <kontsedalbohdan@gmail.com>",
  "homepage": "https://github.com/Kontsedal/olas/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kontsedal/olas.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Kontsedal/olas/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "development": "./dist/dev/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@preact/signals-core": "^1.8.0"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.2",
    "@tanstack/query-core": "^5.103.2",
    "mobx": "^7.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
