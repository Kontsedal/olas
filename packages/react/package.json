{
  "name": "@kontsedal/olas-react",
  "version": "0.8.0",
  "description": "Olas React adapter — OlasProvider, useRoot, useValue, useQuery, useField, useMutation, SuspendOnUnmount, SSR hydration and streaming.",
  "keywords": [
    "olas",
    "controller-tree",
    "signals",
    "reactive",
    "state-management",
    "react",
    "hooks",
    "concurrent-react"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "author": "Bohdan Kontsedal <kontsedalbohdan@gmail.com>",
  "homepage": "https://github.com/Kontsedal/olas/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kontsedal/olas.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Kontsedal/olas/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
