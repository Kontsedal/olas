    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@kontsedal/olas-core": ">=0.3.0 <1.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@kontsedal/olas-core": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "preact": "^10.29.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
