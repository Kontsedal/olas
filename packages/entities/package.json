{
  "name": "@kontsedal/olas-entities",
  "version": "0.8.0",
  "description": "Entity-normalization plugin for Olas — extract entities from query results, subscribe per-id, patch every query holding an entity in one call.",
  "keywords": [
    "olas",
    "controller-tree",
    "signals",
    "reactive",
    "state-management",
    "normalization",
    "entities",
    "cache",
    "cross-query"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "author": "Bohdan Kontsedal <kontsedalbohdan@gmail.com>",
  "homepage": "https://github.com/Kontsedal/olas/tree/main/packages/entities#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kontsedal/olas.git",
    "directory": "packages/entities"
  },
  "bugs": {
    "url": "https://github.com/Kontsedal/olas/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@kontsedal/olas-core": ">=0.3.0 <1.0.0"
  },
  "devDependencies": {
    "@kontsedal/olas-core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
