{
  "name": "@kontsedal/olas-svelte",
  "version": "1.0.0",
  "description": "Olas Svelte adapter — setRoot/getRoot context and store views over queries, fields and mutations. Olas signals are Svelte stores as they are.",
  "keywords": [
    "olas",
    "controller-tree",
    "signals",
    "reactive",
    "state-management",
    "svelte",
    "stores"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "author": "Bohdan Kontsedal <kontsedalbohdan@gmail.com>",
  "homepage": "https://github.com/Kontsedal/olas/tree/main/packages/svelte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kontsedal/olas.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/Kontsedal/olas/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.svelte-check.json --fail-on-warnings"
  },
  "peerDependencies": {
    "@kontsedal/olas-core": ">=1.0.0 <2.0.0",
    "svelte": ">=4"
  },
  "devDependencies": {
    "@kontsedal/olas-core": "workspace:^",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
