{
  "name": "olas",
  "private": true,
  "version": "0.0.0",
  "description": "Olas — controller-tree architecture for browser apps",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" typecheck",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "npm run test -- --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "publint": "pnpm -r --filter \"./packages/*\" --filter \"!@kontsedal/olas-integration-tests\" exec publint",
    "attw": "pnpm -r --filter \"./packages/*\" --filter \"!@kontsedal/olas-integration-tests\" exec attw --pack . --profile esm-only",
    "smoke:dist": "node scripts/verify-dist.mjs",
    "verify:dist": "pnpm build && pnpm publint && pnpm attw && pnpm smoke:dist && pnpm check:public-types && pnpm size",
    "changeset": "changeset",
    "version-packages": "node scripts/check-peer-bumps.mjs && changeset version && node scripts/pin-peer-ranges.mjs",
    "check:peer-ranges": "node scripts/pin-peer-ranges.mjs --check",
    "check:peer-bumps": "node scripts/check-peer-bumps.mjs",
    "release": "pnpm build && changeset publish",
    "wiki:lint": "tsx scripts/wiki-lint.ts",
    "prose:lint": "node scripts/prose-lint.mjs",
    "size": "size-limit",
    "check:public-types": "tsx scripts/check-public-types.ts",
    "bench": "vitest bench --run",
    "mutation": "stryker run",
    "check:doc-snippets": "tsx scripts/check-doc-snippets.ts",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:dev": "node scripts/docs-sync.mjs && vitepress dev docs",
    "docs:build": "pnpm build && pnpm api:check && node scripts/docs-sync.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-documenter": "^7.30.16",
    "@microsoft/api-extractor": "^7.59.2",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "publint": "^0.3.24",
    "semver": "^7.8.5",
    "size-limit": "^14.0.0",
    "svelte": "^5.57.1",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unrun": "^0.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
